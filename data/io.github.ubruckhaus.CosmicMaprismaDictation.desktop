[Desktop Entry]
Name=Maprisma Dictation
Comment=Click to open or close the dictation overlay; right click for its menu
Type=Application
Exec=maprisma-dictation-applet
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Dictation;Voice;Assistant;Maprisma;
