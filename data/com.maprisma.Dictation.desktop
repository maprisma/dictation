[Desktop Entry]
Name=Maprisma Dictation
Comment=Speak or type a question; the AI helper answers in a small overlay
Type=Application
Exec=maprisma-dictation --toggle
Icon=com.maprisma.Dictation
Terminal=false
NoDisplay=true
StartupNotify=false
Categories=Utility;Accessibility;
Keywords=voice;dictation;assistant;AI;speech;
